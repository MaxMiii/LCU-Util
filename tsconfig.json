{
  "compilerOptions": {
    // 编译目标：ES6 以支持现代浏览器和 Electron
    "target": "esnext",
    "module": "esnext",
    // 模块解析策略
    "moduleResolution": "node",
    // 启用严格模式
    "strict": true,
    // JSX 处理（Vue 使用 preserve 模式）
    "jsx": "preserve",
    // 允许导入 JSON 模块
    "resolveJsonModule": true,
    // 允许 CommonJS 和 ES Module 互操作
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // 跳过库类型检查以加快编译
    "skipLibCheck": true,
    // 强制文件名大小写一致
    "forceConsistentCasingInFileNames": true,
    // 基础路径
    "baseUrl": ".",
    // 路径别名（与 webpack 配置保持一致）
    "paths": {
      "@/*": ["src/*"]
    },
    // 包含的库类型
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    // 允许的文件类型（必须与实际安装的类型包严格匹配）
    "types": ["node"],
    // 源码映射
    "sourceMap": true,
    // 输出目录（仅用于类型检查，不实际输出）
    "noEmit": true,
    // 导入 .vue 文件时的类型支持
    "isolatedModules": true
  },
  // 显式引用的文件
  "files": [
    "src/shims-vue.d.ts"
  ],
  // 包含的文件范围
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  // 排除的文件范围
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron"
  ]
}
