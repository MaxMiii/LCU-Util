{
  "name": "lcu-util",
  "version": "1.0.0",
  "private": true,
  "description": "LCU-Util - 基于 Vue3 + Electron + Element-Plus",
  "main": "electron/main.js",
  "author": "LCU-Util",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "type-check": "tsc --noEmit",
    "electron:dev": "nodemon --exec \"npm run build && cross-env NODE_ENV=development electron ./electron/main.js\" --watch src --ext ts,vue,scss,json",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.js",
    "electron:serve": "concurrently \"npm run serve\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron ./electron/main.js\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "axios": "^1.18.1",
    "core-js": "^3.8.3",
    "element-plus": "^2.2.0",
    "i18next": "^26.3.6",
    "i18next-vue": "^5.4.0",
    "pinia": "^4.0.2",
    "sass": "^1.54.0",
    "sass-loader": "^13.0.2",
    "vue": "^3.2.13",
    "vue-router": "^4.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/preset-typescript": "^7.29.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "^24.6.0",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "nodemon": "^3.0.0",
    "typescript": "~5.1.0",
    "wait-on": "^7.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "parser": "@typescript-eslint/parser",
      "ecmaVersion": 2020
    },
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-unused-vars": "warn",
      "vue/multi-word-component-names": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
